<?xml version="1.0" encoding="utf-8"?>
<!--
    Haven 0.1.6 "legacy bridge".

    This APK is published under the old application ID so that it updates the existing
    0.1.x installation in place. Its only job is to hand the existing work profile over
    to com.arcturus.haven with DevicePolicyManager.transferOwnership(), so users keep the
    profile and everything inside it.

    The device admin receiver class name MUST stay identical to 0.1.x
    (io.github.kennethchoinfosec.haven.receivers.HavenDeviceAdminReceiver). Android
    tracks the profile owner by this component; renaming it would orphan the profile.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="internalOnly">

    <uses-feature android:name="android.software.device_admin" android:required="true" />
    <uses-feature android:name="android.software.managed_users" android:required="true" />

    <queries>
        <package android:name="com.arcturus.haven" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_egg"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_egg_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <activity
            android:name=".migration.MigrationActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receivers.HavenDeviceAdminReceiver"
            android:description="@string/device_admin_desc"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
