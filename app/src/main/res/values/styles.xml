<resources>
    <style name="AppTheme.Base" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <item name="colorAccent">@color/md_theme_primary</item>
        <item name="android:colorAccent">@color/md_theme_primary</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurfaceVariant</item>
        <item name="android:itemBackground">@color/md_theme_surface</item>
        <item name="android:listViewStyle">@style/ListViewTheme</item>
        <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="materialButtonStyle">@style/Widget.Haven.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.Haven.BottomNavigation</item>
    </style>

    <style name="AppTheme.Override" parent="AppTheme.Base">
        <item name="android:navigationBarColor">@color/md_theme_surfaceContainer</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Override">
        <!-- Empty; override from specific styles. -->
    </style>

    <style name="AppTheme.SetupWizard" parent="AppTheme">
        <item name="android:navigationBarColor">@color/md_theme_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="ListViewTheme" parent="@android:style/Widget.ListView">
        <item name="android:background">@color/md_theme_surface</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="android:background">@color/md_theme_surface</item>
        <item name="android:headerBackground">@color/md_theme_surface</item>
        <item name="android:windowTitleStyle">@style/AlertDialogTitleTextStyle</item>
    </style>

    <style name="AlertDialogTitleTextStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:background">@color/md_theme_surface</item>
    </style>

    <style name="ToolbarTheme" parent="ThemeOverlay.Material3Expressive.Toolbar.Surface">
        <item name="android:textColorPrimary">@color/md_theme_primary</item>
        <item name="colorOnSurface">@color/md_theme_primary</item>
        <item name="popupMenuStyle">@style/Widget.Haven.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Haven.PopupMenu.Overflow</item>
    </style>

    <style name="Widget.Haven.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/md_theme_surface</item>
    </style>

    <style name="Widget.Haven.PopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/md_theme_surface</item>
    </style>

    <style name="Widget.Haven.BottomNavigation" parent="Widget.Material3Expressive.BottomNavigationView">
        <item name="android:background">@color/md_theme_surfaceContainer</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Haven.BottomNavigation.ActiveIndicator</item>
        <item name="itemIconSize">26dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="itemRippleColor">@color/md_theme_primaryContainer</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Haven.BottomNavigation.ActiveIndicator" parent="Widget.Material3Expressive.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/md_theme_primaryContainer</item>
        <item name="android:width">72dp</item>
        <item name="android:height">40dp</item>
    </style>

    <style name="Widget.Haven.SearchField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/md_theme_surfaceContainer</item>
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
        <item name="boxStrokeColor">@color/md_theme_outlineVariant</item>
        <item name="hintTextColor">@color/md_theme_onSurfaceVariant</item>
        <item name="startIconTint">@color/md_theme_onSurfaceVariant</item>
        <item name="endIconTint">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Widget.Haven.Button" parent="Widget.Material3Expressive.Button">
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="TextAppearance.Haven.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Haven.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Haven.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Theme.Haven.Translucent.NoTitleBar" parent="Theme.Material3Expressive.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>

    <style name="Theme.Teres" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">#8ED8D2</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:colorAccent">#8ED8D2</item>
        <item name="android:alertDialogTheme">@style/Theme.Teres.Dialog.Dark</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Teres.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorAccent">#4CACA5</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:colorAccent">#4CACA5</item>
        <item name="android:alertDialogTheme">@style/Theme.Teres.Dialog.Light</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Teres.FullscreenDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Teres.Dialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#8ED8D2</item>
        <item name="android:colorBackground">#202A2C</item>
        <item name="android:textColorPrimary">#F1F5F4</item>
        <item name="android:textColorSecondary">#D0D9D7</item>
        <item name="android:dialogCornerRadius">28dp</item>
        <item name="android:windowMinWidthMinor">87%</item>
        <item name="android:windowMinWidthMajor">65%</item>
    </style>

    <style name="Theme.Teres.Dialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#4CACA5</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#172021</item>
        <item name="android:textColorSecondary">#4B5A58</item>
        <item name="android:dialogCornerRadius">28dp</item>
        <item name="android:windowMinWidthMinor">87%</item>
        <item name="android:windowMinWidthMajor">65%</item>
    </style>

    <style name="TeresTypographyPoppins">
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TeresTypographySystem">
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TeresTypographySans">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TeresTypographySerif">
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TeresTypographyMono">
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
